# Supabase — pooler en transaction mode, puerto 6543 (ver lib/db.ts)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Conexión directa, puerto 5432. Sólo la usa drizzle-kit para migrar
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Auth.js: openssl rand -base64 32
AUTH_SECRET=""
# En Vercel se setea sola. En local no hace falta si usás http://localhost:3000
# AUTH_URL="http://localhost:3000"

# GitHub App — todos estos valores salen de la página de settings de la App.
# OJO: GITHUB_CLIENT_ID/SECRET son los de la App, no los de una OAuth App aparte.
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# El contenido del .pem completo, con los BEGIN/END. Se admiten \n literales.
GITHUB_APP_PRIVATE_KEY=""
